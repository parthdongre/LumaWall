{
  "formatVersion": 1,
  "id": "com.lumawall.examples.webspectrum",
  "name": "Web Spectrum",
  "author": "LumaWall",
  "type": "web",
  "entry": "assets/index.html",
  "permissions": ["mouse", "systemAudio"],
  "properties": [
    {"id":"speed","name":"Speed","kind":"slider","defaultValue":1.0,"minValue":0.2,"maxValue":3.0,"step":0.05},
    {"id":"reactive","name":"Audio Reactive","kind":"toggle","defaultValue":true},
    {"id":"accent","name":"Accent","kind":"color","defaultValue":"#6C63FF"},
    {"id":"mode","name":"Mode","kind":"dropdown","defaultValue":"waves","options":["waves","rings","plasma"]}
  ]
}
